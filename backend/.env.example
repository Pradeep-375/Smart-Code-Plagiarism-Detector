# Copy this file to backend/.env (same folder as app/) and fill in the values. Never commit .env.
ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./dev.db
# First administrator, created on first start only (password: 8+ chars with a letter and a digit)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Faculty self-registration code (leave empty to disable; admins can still create faculty)
FACULTY_REGISTRATION_CODE=
